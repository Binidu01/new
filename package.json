    "android": "cross-env TAURI=true tauri android dev",
    "android:build": "cross-env TAURI=true tauri android build",
    "ios": "cross-env TAURI=true tauri ios dev",
    "ios:build": "cross-env TAURI=true tauri ios build"
  },
