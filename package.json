{
  "name": "newapp",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host --open",
    "build": "tsc --noEmit && vite build && vite build --ssr src/main.tsx",
    "start": "bini-server",
    "preview": "vite preview --host --open",
    "deploy": "bini-deploy",
    "clean": "npx create-bini-app clean",
    "upgrade": "npx create-bini-app upgrade",
    "type-check": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "check": "oxlint src && oxfmt src && tsc --noEmit",
    "dev:native": "vite",
    "tauri": "tauri",
    "tauri:dev": "cross-env TAURI=true tauri dev",
    "tauri:build": "cross-env TAURI=true tauri build",
    "tauri:icon": "tauri icon public/logo.png",
    "sign": "npx create-bini-app sign",
    "doctor": "npx create-bini-app doctor",
    "android": "cross-env TAURI=true tauri android dev",
    "android:build": "cross-env TAURI=true tauri android build",
    "ios": "cross-env TAURI=true tauri ios dev",
    "ios:build": "cross-env TAURI=true tauri ios build"
  },
  "dependencies": {
    "bini-overlay": "^2.1.2",
    "bini-router": "^2.2.1",
    "bini-server": "^2.0.0",
    "bini-ssg": "^2.0.3",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "@tauri-apps/api": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bini-deploy": "link:C:/Users/rbini/OneDrive/Desktop/bini-deploy",
    "bini-env": "^2.0.0",
    "bini-native": "^2.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "@tauri-apps/cli": "latest",
    "cross-env": "latest"
  }
}
