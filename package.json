    "deploy": "bini-deploy",
    "clean": "npx create-bini-app clean",
    "upgrade": "npx create-bini-app upgrade",
    "type-check": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "check": "oxlint src && oxfmt src && tsc --noEmit",
    "dev:native": "vite",
    "tauri": "tauri",
    "tauri:dev": "cross-env TAURI=true tauri dev",
